#!/data/data/com.nuxdroid/files/usr/bin/bash
# nuxdroid-bootstrap postinst - make sure the prefix directories exist
set -euo pipefail

PREFIX="${PREFIX:-/data/data/com.nuxdroid/files/usr}"

log_info() { echo "[INFO] $*"; }

log_info "nuxdroid-bootstrap: setting up prefix at $PREFIX"

# Create essential directories
mkdir -p "$PREFIX"/{bin,lib,libexec,etc,share,var/lib/dpkg,tmp}

# The actual bootstrap files are provided by the NuxDroid app on first launch.
# This meta-package only ensures dependencies are registered in dpkg.
log_info "nuxdroid-bootstrap: dependencies registered. Run the NuxDroid app to extract the bootstrap."

exit 0
