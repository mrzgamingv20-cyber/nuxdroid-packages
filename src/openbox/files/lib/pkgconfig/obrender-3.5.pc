prefix=/data/data/com.nuxdroid/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.nuxdroid/files/usr/lib
includedir=/data/data/com.nuxdroid/files/usr/include

xcflags=
xlibs= -lSM -lICE  -lX11

Name: ObRender
Description: Openbox Render Library
Version: 3.6
Requires: obt-3.5 glib-2.0 xft pangoxft imlib2 librsvg-2.0
Libs: -L${libdir} -lobrender ${xlibs}
Cflags: -I${includedir}/openbox/3.6 ${xcflags}
